# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.
# On Vercel, set the same variables under Project Settings > Environment Variables.

# --- Server only ---------------------------------------------------------
# Never prefix these with NEXT_PUBLIC_. They are read via src/lib/env/server.ts,
# which imports "server-only" so the build fails if client code touches them.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase secret key (sb_secret_...) or legacy service_role key.
# Bypasses Row Level Security. Server only.
SUPABASE_SECRET_KEY=

# --- Public (exposed to the browser) ------------------------------------
# Not used in v1: there is no browser Supabase client. All database access
# goes through our own server endpoints. Only add this if a browser client
# is introduced deliberately, and only together with strict RLS policies.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Meta (module 7), optional ---------------------------------------------
# Without these, tracking is built but off; leads are still saved.
# Pixel / dataset id from Meta Events Manager. Public: also used in the browser.
# NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (Events Manager > Settings). Secret, server only.
# META_CAPI_ACCESS_TOKEN=
# Only while testing: the code from Events Manager > Test events.
# META_TEST_EVENT_CODE=

# --- Datafordeler (module 6), optional -------------------------------------
# API key from https://portal.datafordeler.dk (IT-system > API-nøgler). Server
# only. Without it, the registers are off and users type everything themselves.
# New keys take 15 minutes or more before Datafordeler accepts them.
# DATAFORDELER_API_KEY=
